{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    // Coupled to `noEmit`: the pure modules in src/lib/hdri import each other
    // with explicit `.ts` specifiers so that scripts/convert-hdri.ts can run the
    // very same files under Node (native type stripping requires the extension).
    // Removing `noEmit` makes tsc reject every one of those imports.
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // The encoder page is browser code that happens to live in scripts/.
  "include": ["src", "scripts/hdri-encoder.ts"]
}

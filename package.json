{
  "name": "web3d-studio",
  "version": "0.1.0",
  "description": "Web3D Studio — Create interactive 3D experiences with camera paths and export as embeddable widgets",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit && vite build",
    "build:widget": "vite build --config vite.config.widget.ts",
    "preview": "vite preview",
    "hdri:selftest": "node scripts/hdri-selftest.ts",
    "presets:hdri": "node scripts/convert-hdri.ts",
    "optimize-glb": "gltf-transform optimize assets/free_1975_porsche_911_930_turbo.glb assets/porsche-911.glb --compress draco --texture-compress webp",
    "optimize:selftest": "node scripts/optimize-selftest.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fontsource/geist-mono": "^5.2.8",
    "@fontsource/geist-sans": "^5.2.5",
    "@gltf-transform/core": "^4.4.0",
    "@gltf-transform/extensions": "^4.4.0",
    "@gltf-transform/functions": "^4.4.0",
    "@monogrid/gainmap-js": "3.4.0",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-toggle": "^1.1.12",
    "@radix-ui/react-toggle-group": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "draco3dgltf": "^1.5.7",
    "idb": "^8.0.3",
    "lucide-react": "^1.21.0",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.4.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "tailwindcss": "^4.3.1"
  }
}
